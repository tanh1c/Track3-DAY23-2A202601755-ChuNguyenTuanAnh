# LLM API key (required for deliberate live LLM validation — pick exactly one)
GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: override the provider's default model
# LLM_MODEL=gemini-2.5-flash

# Optional: use one structured LLM-as-judge call in evaluate_node (default: true)
# LLM_JUDGE=true

# Optional: real HITL interrupt/resume path (default: false / mock approval)
# LANGGRAPH_INTERRUPT=true

# Scenario-run persistence is configured in configs/lab.yaml.
# The final evidence config uses SQLite; do not assume CHECKPOINTER here controls the CLI.

LOG_LEVEL=INFO
